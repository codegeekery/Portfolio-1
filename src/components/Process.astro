---
import SectionHeader from './SectionHeader.astro';
import { process } from '../data/content';
---

<section id="proceso" class="bg-lila py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader title={process.title} subtitle={process.subtitle} />

    <ol class="relative mt-14 grid gap-10 border-l-2 border-ultramar/30 pl-7 md:grid-cols-4 md:gap-8 md:border-t-2 md:border-l-0 md:pt-10 md:pl-0">
      {
        process.steps.map((step) => (
          <li class="relative">
            <span
              class="absolute top-1.5 -left-[2.32rem] size-4 rounded-full border-4 border-lila bg-ultramar md:top-[-3.1rem] md:left-0"
              aria-hidden="true"
            />
            <p class="font-semibold text-ultramar">{step.when}</p>
            <h3 class="type-display mt-1 text-h3">{step.title}</h3>
            <p class="mt-3 max-w-[32ch] text-gris">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
