---
import { orgChart } from '../data/content';

const initials = (name: string) =>
  name
    .split(' ')
    .map((n) => n[0])
    .slice(0, 2)
    .join('');

// Orden en que se cubren los puestos (no de izquierda a derecha, para que se sienta natural)
const fillOrder = [1, 4, 0, 5, 2, 3];
const total = orgChart.departments.reduce((n, d) => n + d.people.length, 0);
let index = 0;

const line = 'bg-tinta/25';
---

<figure id="org-chart" class="relative">
  <div class="rounded-[1.75rem] bg-lila p-4 sm:p-7 lg:p-9">
    <!-- Dirección -->
    <div class="mx-auto w-fit rounded-xl bg-tinta px-5 py-2.5 text-center lg:px-7 lg:py-3 text-white">
      <p class="text-xs text-white/70">{orgChart.head.title}</p>
      <p class="type-display text-xl leading-tight">{orgChart.head.name}</p>
    </div>
    <div class="relative h-5" aria-hidden="true">
      <span class:list={['absolute top-0 left-1/2 h-full w-px', line]}></span>
    </div>

    <!-- Departamentos -->
    <div class="relative grid grid-cols-3 gap-3">
      <span
        class:list={['absolute top-0 h-px', line]}
        style="left: calc((100% - 1.5rem) / 6); right: calc((100% - 1.5rem) / 6);"
        aria-hidden="true"
      ></span>

      {
        orgChart.departments.map((dept) => (
          <div class="flex flex-col">
            <span class:list={['mx-auto h-4 w-px', line]} aria-hidden="true" />
            <p class="mb-2.5 text-center text-sm font-semibold lg:mb-3 lg:text-base">{dept.name}</p>
            <ul class="flex flex-col gap-2.5 lg:gap-3">
              {dept.people.map((person) => {
                const i = index++;
                const tone = i % 2 === 0 ? 'bg-violeta' : 'bg-ultramar';
                return (
                  <li class="slot" data-slot data-order={fillOrder.indexOf(i)}>
                    <div class="slot-vacant flex min-h-[5.25rem] flex-col items-center justify-center rounded-xl border-2 border-dashed border-tinta/25 px-1.5 text-center sm:min-h-[4.5rem] lg:min-h-[5.5rem] sm:flex-row sm:justify-start sm:gap-3 sm:px-3 sm:text-left" aria-hidden="true">
                      <span class="hidden size-9 shrink-0 rounded-full border-2 border-dashed border-tinta/25 sm:block lg:size-11" />
                      <span>
                        <span class="block text-sm font-semibold text-gris lg:text-base">Vacante</span>
                        <span class="block text-[0.7rem] leading-snug text-gris sm:text-xs lg:text-sm">{person.role}</span>
                      </span>
                    </div>
                    <div class="slot-filled flex min-h-[5.25rem] flex-col items-center justify-center gap-1 rounded-xl bg-white px-1.5 text-center shadow-[0_1px_0_rgb(26_23_72/0.08)] sm:min-h-[4.5rem] lg:min-h-[5.5rem] sm:flex-row sm:justify-start sm:gap-3 sm:px-3 sm:text-left">
                      <span class:list={['grid size-8 shrink-0 place-items-center rounded-full text-xs font-bold text-white sm:size-9 lg:size-11 lg:text-sm', tone]}>
                        {initials(person.name)}
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[0.8rem] leading-tight font-semibold sm:text-sm lg:text-base">{person.name}</span>
                        <span class="block text-[0.7rem] leading-snug text-gris sm:text-xs lg:text-sm">{person.role}</span>
                      </span>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-5 flex items-center justify-between gap-4 border-t border-tinta/10 pt-4 text-sm">
      <p class="font-semibold">
        <span data-filled-count>{total}</span> de {total} puestos cubiertos
      </p>
      <button
        type="button"
        data-replay
        class="hidden rounded-lg px-2 py-1 font-semibold text-ultramar underline decoration-2 underline-offset-4 hover:text-ultramar-deep"
      >
        Ver de nuevo
      </button>
    </div>
  </div>
  <figcaption class="mt-4 text-sm text-gris">{orgChart.caption}</figcaption>
</figure>

<script>
  const chart = document.getElementById('org-chart');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (chart && !reduceMotion) {
    const slots = [...chart.querySelectorAll<HTMLElement>('[data-slot]')].sort(
      (a, b) => Number(a.dataset.order) - Number(b.dataset.order),
    );
    const count = chart.querySelector('[data-filled-count]')!;
    const replay = chart.querySelector<HTMLButtonElement>('[data-replay]')!;
    let timers: number[] = [];

    const run = () => {
      timers.forEach(clearTimeout);
      timers = [];
      slots.forEach((s) => s.classList.remove('is-filled'));
      count.textContent = '0';
      replay.classList.add('hidden');

      slots.forEach((slot, i) => {
        timers.push(
          window.setTimeout(() => {
            slot.classList.add('is-filled');
            count.textContent = String(i + 1);
            if (i === slots.length - 1) replay.classList.remove('hidden');
          }, 900 + i * 520),
        );
      });
    };

    replay.addEventListener('click', run);
    run();
  }
</script>
