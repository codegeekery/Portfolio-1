---
import { site } from '../data/content';

interface Props {
  light?: boolean;
}

const { light = false } = Astro.props;
---

<span class="flex items-center gap-2.5">
  <svg viewBox="0 0 32 32" class="size-8 shrink-0" aria-hidden="true">
    <rect width="32" height="32" rx="9" fill={light ? '#fbfaff' : '#2f3cf5'} />
    <rect x="12" y="6" width="8" height="6" rx="2" fill="#8a3ffc" />
    <path d="M16 12v4M9 16h14M9 16v4M23 16v4" stroke={light ? '#1a1748' : '#fbfaff'} stroke-width="2" fill="none" stroke-linecap="round" />
    <rect x="5" y="20" width="8" height="6" rx="2" fill={light ? '#1a1748' : '#fbfaff'} />
    <rect x="19" y="20" width="8" height="6" rx="2" fill={light ? '#1a1748' : '#fbfaff'} />
  </svg>
  <span class:list={['type-display text-[1.6rem] leading-none', light ? 'text-white' : 'text-tinta']}>
    {site.name}
  </span>
</span>
